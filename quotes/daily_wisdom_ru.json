[
    {
        "id": "q001",
        "text": "Мы страдаем чаще в воображении, чем в реальности.",
        "author": "Сенека",
        "years": "4 до н.э. – 65 н.э.",
        "image_file": "seneca.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q002",
        "text": "Людей мучают не сами вещи, а их представления о них.",
        "author": "Эпиктет",
        "years": "50 – 135 н.э.",
        "image_file": "epictetus.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q003",
        "text": "Для того, кто не знает, в какую гавань он плывет, ни один ветер не будет попутным.",
        "author": "Сенека",
        "years": "4 до н.э. – 65 н.э.",
        "image_file": "seneca.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q004",
        "text": "Лучший способ отомстить — не быть похожим на обидчика.",
        "author": "Марк Аврелий",
        "years": "121 – 180 н.э.",
        "image_file": "marcus_aurelius.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q005",
        "text": "Куда бы вы ни шли, идите со всей душой.",
        "author": "Конфуций",
        "years": "551 – 479 до н.э.",
        "image_file": "konfutsiy.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q006",
        "text": "Все, что раздражает нас в других, может привести к пониманию себя.",
        "author": "Карл Густав Юнг",
        "years": "1875 – 1961",
        "image_file": "karl_gustav_yung.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q007",
        "text": "Большинство людей в действительности не хотят свободы, потому что она предполагает ответственность, а ответственность большинство людей страшит.",
        "author": "Зигмунд Фрейд",
        "years": "1856 – 1939",
        "image_file": "zigmund_freyd.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q008",
        "text": "Не расставайтесь со своими иллюзиями. Когда их не станет, может быть, вы и продолжите существовать, но перестанете жить.",
        "author": "Марк Твен",
        "years": "1835 – 1910",
        "image_file": "mark_tven.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q009",
        "text": "Будь собой. Все остальные роли уже заняты.",
        "author": "Оскар Уайльд",
        "years": "1854 – 1900",
        "image_file": "oskar_uayld.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q010",
        "text": "Если проблему можно решить, не стоит о ней беспокоиться. Если нет — беспокойство бесполезно.",
        "author": "Шантидева",
        "years": "VIII век н.э.",
        "image_file": "shantideva.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q011",
        "text": "Осознанность — это осознавание, которое возникает путем целенаправленного внимания, в настоящем моменте и безоценочно.",
        "author": "Джон Кабат-Зинн",
        "years": "1944 – н.в.",
        "image_file": "jon_kabat_zinn.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q012",
        "text": "Будьте нежны с собой. Вы делаете всё возможное.",
        "author": "Кристин Нефф",
        "years": "1966 – н.в.",
        "image_file": "kristin_neff.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q013",
        "text": "Кто много говорит, тот часто терпит неудачу.",
        "author": "Лао-цзы",
        "years": "VI-V вв. до н.э.",
        "image_file": "laotszy.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q014",
        "text": "С несправедливостью либо сражаются, либо сотрудничают.",
        "author": "Альбер Камю",
        "years": "1913 – 1960",
        "image_file": "alber_kamyu.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q015",
        "text": "Тот, кто знает людей, благоразумен. Знающий себя — просвещен.",
        "author": "Лао-цзы",
        "years": "VI-V вв. до н.э.",
        "image_file": "laotszy.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q016",
        "text": "Твое представление причиняет тебе вред в тот момент, когда ты веришь, что тебе причинен вред.",
        "author": "Эпиктет",
        "years": "50 – 135 н.э.",
        "image_file": "epictetus.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q017",
        "text": "Внимание — самая редкая и чистая форма щедрости.",
        "author": "Симона Вейль",
        "years": "1909 – 1943",
        "image_file": "simone_weil.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q018",
        "text": "Свобода каждого человека ограничена свободой других.",
        "author": "Маттиас Клаудиус",
        "years": "1740 – 1815",
        "image_file": "immanuil_kant.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q019",
        "text": "Привычка есть механизм чувства самого себя, подобно тому, как память есть механизм интеллекта.",
        "author": "Георг Гегель",
        "years": "1770 – 1831",
        "image_file": "georg_gegel.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q020",
        "text": "Кто не любит одиночества, не любит и свободы; ибо только в одиночестве человек свободен.",
        "author": "Артур Шопенгауэр",
        "years": "1788 – 1860",
        "image_file": "artur_shopengauer.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q021",
        "text": "Сопротивление реальности создает страдание.",
        "author": "Байрон Кейти",
        "years": "1942 – н.в.",
        "image_file": "byron_katie.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q022",
        "text": "Самое тяжкое бремя для ребенка — это непрожитая жизнь его родителей.",
        "author": "Карл Густав Юнг",
        "years": "1875 – 1961",
        "image_file": "karl_gustav_yung.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q023",
        "text": "Два самых важных дня в твоей жизни: день, когда ты родился, и день, когда ты понял — зачем.",
        "author": "Уильям Баркли",
        "years": "1907 – 1978",
        "image_file": "mark_tven.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q024",
        "text": "Не трать больше времени на споры о том, каким должен быть хороший человек. Будь им.",
        "author": "Марк Аврелий",
        "years": "121 – 180 н.э.",
        "image_file": "marcus_aurelius.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q025",
        "text": "Удача любит смелых.",
        "author": "Сенека",
        "years": "4 до н.э. – 65 н.э.",
        "image_file": "seneca.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q026",
        "text": "Победа над самим собой — величайшая из побед.",
        "author": "Будда",
        "years": "563 – 483 до н.э.",
        "image_file": "buddha.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q027",
        "text": "Девять десятых нашего счастья основано на здоровье.",
        "author": "Артур Шопенгауэр",
        "years": "1788 – 1860",
        "image_file": "artur_shopengauer.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q028",
        "text": "Никто не верует в собственную смерть. В бессознательном каждый из нас убежден в своем бессмертии.",
        "author": "Зигмунд Фрейд",
        "years": "1856 – 1939",
        "image_file": "zigmund_freyd.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q029",
        "text": "Влюбленность начинается с того, что человек обманывает себя, а кончается тем, что он обманывает другого.",
        "author": "Оскар Уайльд",
        "years": "1854 – 1900",
        "image_file": "oskar_uayld.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q030",
        "text": "То, что мы есть сегодня, — это следствие наших вчерашних мыслей.",
        "author": "Будда",
        "years": "563 – 483 до н.э.",
        "image_file": "buddha.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q031",
        "text": "Речь — удивительно сильное средство, но нужно иметь много ума, чтобы пользоваться им.",
        "author": "Георг Гегель",
        "years": "1770 – 1831",
        "image_file": "georg_gegel.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q032",
        "text": "Как ты читаешь, никто не читает и никто до тебя не читал.",
        "author": "Ханна Арендт",
        "years": "1906 – 1975",
        "image_file": "martin_haydegger.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q033",
        "text": "Замечайте свои эмоции, но не становитесь ими.",
        "author": "Тара Брах",
        "years": "1953 – н.в.",
        "image_file": "tara_brach.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q034",
        "text": "Когда вы замедляетесь, мир становится яснее.",
        "author": "Пема Чодрон",
        "years": "1936 – н.в.",
        "image_file": "pema_chodron.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q035",
        "text": "Высшее счастье жизни — это уверенность в том, что вас любят.",
        "author": "Виктор Гюго",
        "years": "1802 – 1885",
        "image_file": "seneca.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q036",
        "text": "Надо любить жизнь больше, чем смысл её.",
        "author": "Федор Достоевский",
        "years": "1821 – 1881",
        "image_file": "",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q037",
        "text": "Мы не выносим людей с теми же недостатками, что и у нас.",
        "author": "Оскар Уайльд",
        "years": "1854 – 1900",
        "image_file": "oskar_uayld.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q038",
        "text": "Важно не то, что сделали из меня, а то, что я сам сделал из того, что сделали из меня.",
        "author": "Жан-Поль Сартр",
        "years": "1905 – 1980",
        "image_file": "zhanpol_sartr.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q039",
        "text": "Смотри, не делай ничего, как баран. Иначе и так утрачивается человек.",
        "author": "Эпиктет",
        "years": "50 – 135 н.э.",
        "image_file": "epictetus.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q040",
        "text": "Если вещь не годна для одной цели, ее можно употребить для другой.",
        "author": "Лао-цзы",
        "years": "VI-V вв. до н.э.",
        "image_file": "laotszy.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q041",
        "text": "Вы никогда не будете жить, если будете искать смысл жизни.",
        "author": "Альбер Камю",
        "years": "1913 – 1960",
        "image_file": "alber_kamyu.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q042",
        "text": "Лишь самые мудрые и самые глупые не меняются.",
        "author": "Конфуций",
        "years": "551 – 479 до н.э.",
        "image_file": "konfutsiy.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q043",
        "text": "Единственная истинная мудрость — в осознании, что мы по сути ничего не знаем.",
        "author": "Сократ",
        "years": "470 – 399 до н.э.",
        "image_file": "sokrat.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q044",
        "text": "Люди учатся, как говорить, а главная наука — как и когда молчать.",
        "author": "Лев Толстой",
        "years": "1828 – 1910",
        "image_file": "lev_tolstoy.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q045",
        "text": "Начинай немедленно жить и считай каждый отдельный день за целую жизнь.",
        "author": "Сенека",
        "years": "4 до н.э. – 65 н.э.",
        "image_file": "seneca.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q046",
        "text": "Я сам своя свобода.",
        "author": "Жан-Поль Сартр",
        "years": "1905 – 1980",
        "image_file": "zhanpol_sartr.png",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q047",
        "text": "Свобода — это ответственность, поэтому большинство людей боится её.",
        "author": "Джордж Бернард Шоу",
        "years": "1856 – 1950",
        "image_file": "",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q048",
        "text": "Побеждающий людей силен. Побеждающий самого себя могущественен.",
        "author": "Лао-цзы",
        "years": "VI-V вв. до н.э.",
        "image_file": "laotszy.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q049",
        "text": "Если ты любишь глиняный горшок, то думай: «Я люблю глиняный горшок», и тогда ты не будешь волноваться, когда он разобьется.",
        "author": "Эпиктет",
        "years": "50 – 135 н.э.",
        "image_file": "epictetus.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q050",
        "text": "Если хочешь жить спокойно и весело, старайся вести знакомство только с хорошими людьми.",
        "author": "Эпиктет",
        "years": "50 – 135 н.э.",
        "image_file": "epictetus.jpg",
        "phases": [
            0,
            1,
            2,
            3,
            4
        ]
    },
    {
        "id": "q051",
        "text": "Настоящий момент — единственное место, где возможна жизнь.",
        "author": "Тик Нят Хань",
        "years": "1926 – 2022",
        "image_file": "thich_nhat_hanh.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q052",
        "text": "Вы — не ваш ум.",
        "author": "Экхарт Толле",
        "years": "1948 – н.в.",
        "image_file": "eckhart_tolle.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q053",
        "text": "Покой — внутри вас. Не ищите его вовне.",
        "author": "Экхарт Толле",
        "years": "1948 – н.в.",
        "image_file": "eckhart_tolle.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q054",
        "text": "Природа никогда не спешит, но всегда успевает.",
        "author": "Лао-цзы",
        "years": "VI-V вв. до н.э.",
        "image_file": "laotszy.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q055",
        "text": "Тот, кто знает, не говорит. Тот, кто говорит, не знает.",
        "author": "Лао-цзы",
        "years": "VI-V вв. до н.э.",
        "image_file": "laotszy.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q056",
        "text": "Мы — результат наших мыслей.",
        "author": "Будда",
        "years": "563 – 483 до н.э.",
        "image_file": "buddha.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q057",
        "text": "Смерти меньше всего боятся те люди, чья жизнь имеет наибольшую ценность.",
        "author": "Иммануил Кант",
        "years": "1724 – 1804",
        "image_file": "immanuil_kant.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q058",
        "text": "У человека можно отнять всё, кроме одного: последней свободы человека — выбирать собственное отношение к любым обстоятельствам.",
        "author": "Виктор Франкл",
        "years": "1905 – 1997",
        "image_file": "viktor_frankl.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q059",
        "text": "Смысл жизни в том, чтобы наполнять её смыслом.",
        "author": "Виктор Франкл",
        "years": "1905 – 1997",
        "image_file": "viktor_frankl.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q060",
        "text": "Мир абсурден, и тот, кто это осознает, обретает свободу.",
        "author": "Альбер Камю",
        "years": "1913 – 1960",
        "image_file": "alber_kamyu.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q061",
        "text": "Сегодняшний человек спасается бегством от мышления.",
        "author": "Мартин Хайдеггер",
        "years": "1889 – 1976",
        "image_file": "martin_haydegger.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q062",
        "text": "Смерть в широчайшем смысле есть феномен жизни.",
        "author": "Мартин Хайдеггер",
        "years": "1889 – 1976",
        "image_file": "martin_haydegger.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q063",
        "text": "Познание духа есть самое конкретное и потому самое высокое и трудное.",
        "author": "Георг Гегель",
        "years": "1770 – 1831",
        "image_file": "georg_gegel.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q064",
        "text": "Только дух представляет собой истинное, как всеобъемлющее начало.",
        "author": "Георг Гегель",
        "years": "1770 – 1831",
        "image_file": "georg_gegel.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q065",
        "text": "Ничто не вечно. Всё возникает и исчезает.",
        "author": "Будда",
        "years": "563 – 483 до н.э.",
        "image_file": "buddha.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q066",
        "text": "Страдание возникает из желания.",
        "author": "Будда",
        "years": "563 – 483 до н.э.",
        "image_file": "buddha.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q067",
        "text": "Осознанность — путь к бессмертию.",
        "author": "Будда",
        "years": "563 – 483 до н.э.",
        "image_file": "buddha.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q068",
        "text": "Живи так, как будто ты сейчас должен проститься с жизнью.",
        "author": "Марк Аврелий",
        "years": "121 – 180 н.э.",
        "image_file": "marcus_aurelius.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q069",
        "text": "Неосмысленная жизнь не стоит того, чтобы жить.",
        "author": "Сократ",
        "years": "470 – 399 до н.э.",
        "image_file": "sokrat.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q070",
        "text": "Без музыки жизнь была бы заблуждением.",
        "author": "Фридрих Ницше",
        "years": "1844 – 1900",
        "image_file": "fridrih_nitsshe.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q071",
        "text": "Истинная задача жизни — это искусство.",
        "author": "Фридрих Ницше",
        "years": "1844 – 1900",
        "image_file": "fridrih_nitsshe.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q072",
        "text": "Настоящая свобода начинается по ту сторону отчаяния.",
        "author": "Жан-Поль Сартр",
        "years": "1905 – 1980",
        "image_file": "zhanpol_sartr.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q073",
        "text": "Осознанность — это возвращение домой к себе.",
        "author": "Тик Нят Хань",
        "years": "1926 – 2022",
        "image_file": "thich_nhat_hanh.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q074",
        "text": "Где бы ты ни был — будь там полностью.",
        "author": "Экхарт Толле",
        "years": "1948 – н.в.",
        "image_file": "eckhart_tolle.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q075",
        "text": "Разрешите себе быть тем, кто вы есть.",
        "author": "Джон Кабат-Зинн",
        "years": "1944 – н.в.",
        "image_file": "jon_kabat_zinn.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q076",
        "text": "Перестаньте бороться с тем, что есть — начните наблюдать.",
        "author": "Джон Кабат-Зинн",
        "years": "1944 – н.в.",
        "image_file": "jon_kabat_zinn.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q077",
        "text": "От двух вещей нужно непременно избавиться: от страха перед будущим и от воспоминаний о прошлых страданиях.",
        "author": "Сенека",
        "years": "4 до н.э. – 65 н.э.",
        "image_file": "seneca.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q078",
        "text": "К свободе ведет лишь презрение к тому, что не зависит от нас.",
        "author": "Эпиктет",
        "years": "50 – 135 н.э.",
        "image_file": "epictetus.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q079",
        "text": "Полной свободы нет, но человек приближается к свободе по мере соединения своего разума и любви.",
        "author": "Лев Толстой",
        "years": "1828 – 1910",
        "image_file": "lev_tolstoy.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q080",
        "text": "Надо жить, надо любить, надо верить.",
        "author": "Лев Толстой",
        "years": "1828 – 1910",
        "image_file": "lev_tolstoy.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q081",
        "text": "Дао постоянно осуществляет недеяние, однако нет ничего такого, что бы оно не делало.",
        "author": "Лао-цзы",
        "years": "VI-V вв. до н.э.",
        "image_file": "laotszy.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q082",
        "text": "Нет ничего более сильного и созидательного, чем пустота.",
        "author": "Лао-цзы",
        "years": "VI-V вв. до н.э.",
        "image_file": "laotszy.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q083",
        "text": "С точки зрения молодости жизнь есть бесконечно долгое будущее; с точки зрения старости — очень короткое прошлое.",
        "author": "Артур Шопенгауэр",
        "years": "1788 – 1860",
        "image_file": "artur_shopengauer.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q084",
        "text": "Человек может быть вполне самим собою только пока он одинок.",
        "author": "Артур Шопенгауэр",
        "years": "1788 – 1860",
        "image_file": "artur_shopengauer.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q085",
        "text": "Чем больше привычек, тем меньше свободы.",
        "author": "Иммануил Кант",
        "years": "1724 – 1804",
        "image_file": "immanuil_kant.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q086",
        "text": "Ничто не способно повредить доброму человеку, ни в жизни, ни после смерти.",
        "author": "Сократ",
        "years": "470 – 399 до н.э.",
        "image_file": "sokrat.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q087",
        "text": "Достойный человек не может не обладать широтой познаний и твердостью духа. Его ноша тяжела, а путь его долог.",
        "author": "Конфуций",
        "years": "551 – 479 до н.э.",
        "image_file": "konfutsiy.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q088",
        "text": "Все мы достаточно часто бедны мыслью, мы слишком легко становимся бездумными.",
        "author": "Мартин Хайдеггер",
        "years": "1889 – 1976",
        "image_file": "martin_haydegger.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q089",
        "text": "Мука — жить памятью, когда память уже ни на что не нужна.",
        "author": "Альбер Камю",
        "years": "1913 – 1960",
        "image_file": "alber_kamyu.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q090",
        "text": "Не ищи любви. Просто будь тем, что ты ищешь.",
        "author": "Джефф Фостер",
        "years": "1977 – н.в.",
        "image_file": "",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q091",
        "text": "В тот момент, когда человек начинает задумываться о смысле и ценности жизни, его можно считать больным.",
        "author": "Зигмунд Фрейд",
        "years": "1856 – 1939",
        "image_file": "zigmund_freyd.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q092",
        "text": "Язык — дом бытия.",
        "author": "Мартин Хайдеггер",
        "years": "1889 – 1976",
        "image_file": "martin_haydegger.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q093",
        "text": "Тот, кто побеждает людей, силен, тот, кто побеждает себя, могущественен.",
        "author": "Лао-цзы",
        "years": "VI-V вв. до н.э.",
        "image_file": "laotszy.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q094",
        "text": "Духовность, свобода и ответственность — это три экзистенциала человеческого существования.",
        "author": "Виктор Франкл",
        "years": "1905 – 1997",
        "image_file": "viktor_frankl.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q095",
        "text": "Счастье — это отсутствие боли.",
        "author": "Артур Шопенгауэр",
        "years": "1788 – 1860",
        "image_file": "artur_shopengauer.png",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q096",
        "text": "Сопротивление реальности создает боль.",
        "author": "Байрон Кейти",
        "years": "1942 – н.в.",
        "image_file": "byron_katie.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q097",
        "text": "Разрешите себе быть тем, кто вы есть.",
        "author": "Джон Кабат-Зинн",
        "years": "1944 – н.в.",
        "image_file": "jon_kabat_zinn.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q098",
        "text": "Помни — тебе причиняет вред не то, что тебя оскорбляют, а твоё представление об этом.",
        "author": "Эпиктет",
        "years": "50 – 135 н.э.",
        "image_file": "epictetus.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q099",
        "text": "Живи так, как будто каждое мгновение — это подарок.",
        "author": "Марк Аврелий",
        "years": "121 – 180 н.э.",
        "image_file": "marcus_aurelius.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    },
    {
        "id": "q100",
        "text": "Внимание — чистая форма щедрости.",
        "author": "Симона Вейль",
        "years": "1909 – 1943",
        "image_file": "simone_weil.jpg",
        "phases": [
            5,
            6,
            7,
            8
        ]
    }
]
